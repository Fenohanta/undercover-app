# Clé API Google Gemini (gratuite sur aistudio.google.com)
VITE_GEMINI_API_KEY=AIza...

# Firebase — Realtime Database (console.firebase.google.com)
# Créez un projet > Realtime Database > Authentification (anonymous)
VITE_FIREBASE_API_KEY=AIza...
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.europe-west1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abc123
